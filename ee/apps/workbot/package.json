{
  "name": "@openwork-ee/workbot",
  "private": true,
  "type": "module",
  "description": "Workbot on its own address: one ongoing chat per member, signed in with Den, answered on the headless runner.",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "WORKBOT_DEV=1 NODE_OPTIONS=\"${NODE_OPTIONS:-} --conditions=development\" tsx watch --ignore 'src/client/**' src/server/main.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build && esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --conditions=development --outfile=dist/server.js --external:hono --external:@hono/node-server --external:zod --external:vite --external:@sentry/node",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:scroll-browser": "node scripts/scroll-browser.mjs",
    "test:navigation-browser": "node scripts/navigation-browser.mjs",
    "test:gateway-models": "tsx --conditions=development --test scripts/gateway-models.test.ts",
    "test:context": "tsx --conditions=development --test scripts/context.test.ts",
    "test:connector-browser": "node scripts/connector-browser.mjs",
    "test:artifact-browser": "node scripts/artifact-browser.mjs",
    "test:task-sheet-browser": "node scripts/task-sheet-browser.mjs",
    "test:session-cells": "tsx --conditions=development --test scripts/session-cells.test.ts",
    "test:command-palette": "tsx --conditions=development --test scripts/command-palette.test.ts",
    "test:calendar-connections": "esbuild scripts/calendar-connections.test.ts --bundle --conditions=development --platform=node --format=cjs --jsx=automatic --external:react --external:react-dom --external:@tanstack/react-query --external:zod --outfile=node_modules/.cache/calendar-connections.test.cjs && node node_modules/.cache/calendar-connections.test.cjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@openwork-ee/headless-protocol": "workspace:*",
    "@openwork-ee/workbot-server": "workspace:*",
    "@openwork-ee/workbot-ui": "workspace:*",
    "@openwork/types": "workspace:*",
    "@sentry/node": "10.64.0",
    "@tanstack/react-query": "^5.96.2",
    "hono": "4.13.16",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.6.6",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "0.25.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "^6.4.5"
  }
}
