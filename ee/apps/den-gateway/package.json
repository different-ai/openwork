{
  "name": "@openwork-ee/den-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development OPENWORK_DEV_MODE=1 tsx watch src/server.ts",
    "dev:local": "NODE_OPTIONS=--conditions=development OPENWORK_DEV_MODE=1 PORT=${DEN_GATEWAY_PORT:-8788} tsx watch src/server.ts",
    "test": "bun test --conditions development test/*.test.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@openwork-ee/utils": "workspace:*",
    "dotenv": "^16.4.5",
    "hono": "4.12.34",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
