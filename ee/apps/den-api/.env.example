PORT=8790
DEN_BASE_URL=http://localhost:3005
# Optional compatibility overrides. Leave blank to derive web/auth/CORS/API/MCP
# defaults from DEN_BASE_URL.
CORS_ORIGINS=
DATABASE_URL=mysql://root:password@127.0.0.1:3306/openwork_den
DATABASE_REDIS_URL=redis://127.0.0.1:6379
# Set to 1 only for trusted private, non-public Redis endpoints that do not support TLS,
# such as some Render internal Redis URLs. Prefer rediss:// when available.
DATABASE_REDIS_ALLOW_INSECURE_INTERNAL=0
DB_MODE=mysql
DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
# Required dedicated DB encryption key for encrypted columns. Minimum 32 chars.
# Generate one with: openssl rand -base64 128
DEN_DB_ENCRYPTION_KEY=
BETTER_AUTH_URL=
DEN_BETTER_AUTH_TRUSTED_ORIGINS=
# Shared with Den Web on Vercel, which signs each person's address with it; 32+ chars.
# Unset: forwarded addresses from Den Web are not trusted. Generate: openssl rand -base64 48
DEN_WEB_CLIENT_IP_SECRET=
# Public API base; an HTTPS reverse-proxy prefix such as /api/den is supported.
# OAuth callbacks must bypass upstream SSO/Access challenges.
DEN_API_PUBLIC_URL=
# Managed deployment installers: reviewed, published artifacts, not feature flags.
# All four values per provider plus DEN_API_PUBLIC_URL are required. Never point
# these at a local build or configure placeholder URLs in a real environment.
# Build/publication: docs/managed-deployments.md. Enable rollouts through /admin.
DEN_MANAGED_DEPLOYMENT_AWS_VERSION=
DEN_MANAGED_DEPLOYMENT_AWS_TEMPLATE_URL=
DEN_MANAGED_DEPLOYMENT_AWS_BUNDLE_URL=
DEN_MANAGED_DEPLOYMENT_AWS_BUNDLE_SHA256=
DEN_MANAGED_DEPLOYMENT_GCP_VERSION=
DEN_MANAGED_DEPLOYMENT_GCP_TEMPLATE_URL=
DEN_MANAGED_DEPLOYMENT_GCP_BUNDLE_URL=
DEN_MANAGED_DEPLOYMENT_GCP_BUNDLE_SHA256=
# Optional protocol-compatible endpoint overrides for connector tests. OAuth
# overrides must contain a literal {tenantId} path placeholder. Leave blank in
# production to use tenant-scoped Microsoft Entra and Graph directly.
DEN_MICROSOFT_OAUTH_AUTHORIZE_URL=
DEN_MICROSOFT_OAUTH_TOKEN_URL=
DEN_MICROSOFT_GRAPH_BASE_URL=
# Runtime desktop release discovery. Use static for air-gapped deployments;
# the base URL override is intended for compatible self-hosted/test endpoints.
DEN_DESKTOP_RELEASES_MODE=github
DEN_DESKTOP_RELEASES_BASE_URL=
DEN_DESKTOP_DEN_BASE_URL=
DEN_MARKETING_URL=
DEN_MCP_RESOURCE_URL=
# Extra public MCP resource URLs beyond the DEN_API_PUBLIC_URL API origin and web-app defaults.
DEN_MCP_ADDITIONAL_RESOURCES=
# Enable only after deploying a Desktop release that delivers render-tool
# structuredContent through the stable MCP Apps bridge after initialization.
DEN_GENERATED_ARTIFACT_VIEWS_ENABLED=false
# Kill switch for Apps built in OpenWork (on for every org by default).
# Where on, orgs build App servers and older Workflow-bound views are read-only.
DEN_APP_MCP_SERVERS_ENABLED=true
# Leave unset on hosted/multi-tenant deployments. Set to 1 only when Den runs
# inside a private network and your MCP servers are on private addresses.
# OPENWORK_DEV_MODE=1 already exempts local dev.
DEN_ALLOW_PRIVATE_MCP_URLS=
# Optional operator-owned override for the Org settings egress diagnostic.
# The browser can never change it; the default is https://diagnostic.openworklabs.com.
DEN_DIAGNOSTICS_ORIGIN=https://diagnostic.openworklabs.com
# Optional bootstrap fallback for the synthetic test secret. Organization admins
# normally enter and rotate this encrypted value in Den's Org settings. Never
# use a customer credential or provider secret here.
DEN_DIAGNOSTICS_BEARER_TOKEN=OpenWorkDiagnosticsToken!
# Node.js 24.5+: when corporate egress requires a proxy, set
# NODE_USE_ENV_PROXY=1 together with HTTPS_PROXY and NO_PROXY on the Den
# container. Set NODE_EXTRA_CA_CERTS when TLS inspection uses a private CA.
# Defaults to BETTER_AUTH_URL when blank. Set this to a stable hosted namespace
# before issuing MCP tokens if you need claim URI compatibility across host moves.
# Use https://openworklabs.com to preserve the original hosted MCP claim names.
DEN_MCP_CLAIM_NAMESPACE=
# Optional comma-separated platform admin emails to seed on startup.
# Leave blank to disable bootstrap admin seeding for self-hosted installs.
DEN_BOOTSTRAP_ADMIN_EMAILS=
EMAIL_FROM=OpenWork <team@openworklabs.com>
# Optional address for replies to invitation emails and their "Report abuse" link.
# Unset: OpenWork Cloud uses team@openworklabs.com; self-hosted replies reach the inviter.
EMAIL_SUPPORT_ADDRESS=
# Transactional email uses Resend when RESEND_API_KEY is set.
RESEND_API_KEY=
# Otherwise, transactional email uses SMTP/Nodemailer when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Lifecycle reminder emails, sent with the email settings above. Set to 1 to send
# one "claim your workspace" reminder before a provisional workspace expires and
# one "bring your team" nudge to owners still alone 2-14 days in (with unsubscribe).
LIFECYCLE_EMAILS_ENABLED=
# How often the reminder sweep runs, in milliseconds (default 15 minutes).
LIFECYCLE_EMAILS_INTERVAL_MS=
# Scheduled check of which preset MCP providers let OpenWork sign people in
# (Platform admin > GET /v1/admin/mcp-registration). Off unless set to 1.
MCP_REGISTRATION_PROBE_ENABLED=
# 1 also registers (and then deletes, where allowed) OpenWork's OAuth client with
# providers whose metadata cannot tell. Leave unset on self-hosted installs.
MCP_REGISTRATION_PROBE_TRY_REGISTRATION=
# Minimum time between checks of one provider (default 86400000, minimum 3600000).
MCP_REGISTRATION_PROBE_INTERVAL_MS=
# Admin Control Center snapshots (/admin). On unless set to 0; the refresh job
# precomputes platform metrics so the page never runs heavy queries.
ADMIN_METRICS_REFRESH_ENABLED=
# Today's and 7-day KPIs, in milliseconds (default 300000, minimum 60000).
ADMIN_METRICS_FAST_INTERVAL_MS=
# Cohorts, lifecycle, sharing, revenue and accounts (default 1800000, minimum 300000).
ADMIN_METRICS_HEAVY_INTERVAL_MS=
# Optional Loops API key for contact/event syncs after signup and subscription.
LOOPS_API_KEY=
LOOPS_MARKETING_ENABLED=0
# Optional Linear GraphQL integration for best-effort compliance request tickets.
# Leave LINEAR_API_KEY and LINEAR_COMPLIANCE_TEAM_ID blank to disable.
# LINEAR_API_BASE defaults to https://api.linear.app/graphql when unset.
# LINEAR_COMPLIANCE_COMPLETED_STATE_ID marks compliance tickets complete after
# the workflow finishes.
LINEAR_API_KEY=
LINEAR_COMPLIANCE_TEAM_ID=
LINEAR_API_BASE=
LINEAR_COMPLIANCE_COMPLETED_STATE_ID=
# Sandbox host for OpenWork Cloud instances: stub | render | daytona.
# PROVISIONER_MODE is still accepted as an alias.
CLOUD_RUNTIME_PROVIDER=stub
WORKER_PROVISIONING_RECONCILE_INTERVAL_MS=60000
WORKER_PROVISIONING_RECONCILE_STALE_MS=1200000
WORKER_PROVISIONING_RECONCILE_BATCH_SIZE=10
WORKER_URL_TEMPLATE=https://workers.local/{workerId}
WORKER_ACTIVITY_BASE_URL=http://localhost:8790
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_WORKER_PUBLIC_DOMAIN_SUFFIX=
VERCEL_TOKEN=
VERCEL_DNS_DOMAIN=
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
OPENWORK_DEV_MODE=1
# Org mode: blank/unset resolves to single_org in the implemented target state.
# Use multi_org for hosted/cloud-style deployments that allow multiple organizations.
DEN_ORG_MODE=
# Deployment-wide OpenWork Web availability. Hosted OpenWork Cloud sets this
# to true. Missing or false keeps Web hidden and its API unavailable.
DEN_OPENWORK_WEB_ENABLED=false
# Audit availability is included in Enterprise plans. Self-hosted operators may
# explicitly grant it installation-wide without a Cloud plan; keep false in Cloud.
# This does NOT initialize a policy.
DEN_AUDIT_SELF_HOSTED_ENABLED=false
# Default-on deployment switches; explicit false is a global kill switch.
# Ready orgs automatically get a temporary 6,000,000 retained-operation policy.
# Capture starts ON; existing policies/OFF choices are preserved. No cap enforcement.
# Existing capture OFF preferences remain OFF.
DEN_AUDIT_CAPTURE_ENABLED=true
DEN_AUDIT_VISIBILITY_ENABLED=true
# Tenantless requests (auth, public, failed-before-attribution) go to platform_audit_event
# while capture is enabled, including successful side-effect-free (readOnly) platform reads.
# Bearer token (24+ characters) for scheduled maintenance callers, such as the daily
# audit usage refresh: POST /internal/audit/usage/refresh. Unset answers 404.
# DEN_MAINTENANCE_TOKEN=
DEN_SINGLE_ORG_NAME=OpenWork
DEN_SINGLE_ORG_SLUG=default
# Comma-separated emails allowed to claim singleton organization ownership.
DEN_SINGLE_ORG_OWNER_EMAILS=
DEN_SINGLE_ORG_ALLOW_PUBLIC_SIGNUP=false
# Single-org deployments disable signup verification codes by default.
DEN_REQUIRE_EMAIL_VERIFICATION=false

# Observability backend: none (structured JSON stdout), otel (OTLP HTTP/protobuf), or sentry.
# Backends are mutually exclusive. Leave unset/none for local development.
DEN_OBSERVABILITY_BACKEND=none
OTEL_SERVICE_NAME=den-api
# OTEL uses the standard OTEL_* variables. The base endpoint appends /v1/traces,
# /v1/metrics, and /v1/logs unless a per-signal endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=
# Sentry runtime. Source maps upload during build only when SENTRY_AUTH_TOKEN,
# SENTRY_ORG, SENTRY_PROJECT, and SENTRY_RELEASE are present.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.01
# Temporary SCIM diagnostic roots only. Comma-separated opaque internal org IDs,
# never domains/names. Both settings are required; empty/invalid/expired disables.
SENTRY_DEBUG_ORG_IDS=
# Strict ISO 8601 date-time with seconds and Z or numeric timezone offset.
SENTRY_DEBUG_ORGS_EXPIRES_AT=
SENTRY_LOG_LEVEL=warn
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
SENTRY_DIST=
# SENTRY_AUTH_TOKEN is intentionally omitted; provide it only in CI/secret storage.
# Daytona's own OTEL bootstrap remains disabled; den-api does not set Daytona OTEL enable env vars.


OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_WORKSPACE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INFERENCE_PRICE_ID=price_1TWsTW2Ytt5tm5rQTgrMhiP8
STRIPE_SEAT_PRICE_ID=
# Required for OpenWork Web checkout after DEN_OPENWORK_WEB_ENABLED=true.
STRIPE_OPENWORK_WEB_PRICE_ID=
STRIPE_BILLING_SUCCESS_URL=http://localhost:3005/dashboard/billing/stripe/checking?session_id={CHECKOUT_SESSION_ID}
STRIPE_BILLING_CANCEL_URL=http://localhost:3005/dashboard/billing

# Slack Assistant is enabled per organization in /admin → Capabilities.
# Each Slack connector still needs installation, opt-in, and Web access.
# Set false on API-only nodes; at least one worker must share the Den database.
DEN_SLACK_ASSISTANT_WORKER_ENABLED=true
# Optional destination for Slack's "Open in OpenWork Web" links.
# DEN_WEB_OPENWORK_WEB_URL=https://web.openworklabs.com
# Headless runner (ee/apps/headless-runner). Organizations with
# /admin → Capabilities → "Slack Assistant: headless runtime" answer Slack on it
# instead of each member's OpenWork Web computer. Unset = no org can use it.
# DEN_HEADLESS_RUNNER_URL=http://headless-runner:8795
# DEN_HEADLESS_RUNNER_TOKEN=<same value as the runner's HEADLESS_API_TOKEN, 32+ chars>
# Lets the runner continue saved turns on its own after a restart:
# the token it presents when exchanging a turn's
# resume grant at POST /v1/headless/resume-token, and when reporting to Den's
# session index at POST /v1/internal/headless/index. Same value as the runner's
# HEADLESS_DEN_CALLBACK_TOKEN; 32+ chars and different from
# DEN_HEADLESS_RUNNER_TOKEN. Unset = both routes answer 404.
# DEN_HEADLESS_RUNNER_CALLBACK_TOKEN=<32+ chars>
# Organizations with "Cloud Automations: headless runtime" (Team or Enterprise)
# run cloud agent Automations on the runner too, with no OpenWork Web seat.
# Headless runs have their own pool; the Web pool is DEN_AUTOMATIONS_MAX_CONCURRENCY.
# DEN_HEADLESS_AUTOMATIONS_MAX_CONCURRENCY=16

# Optional free/open-source Collabora Online editor. workbotDocuments stays off by default.
# Run Collabora CODE or an MPL-2.0 source build on a separate trusted HTTPS origin.
DEN_DOCUMENTS_COLLABORA_URL=
# The Workbot browser origin, allowlisted for editor postMessage events.
DEN_DOCUMENTS_HOST_ORIGIN=
# Den API origin reachable from Collabora; defaults to DEN_API_PUBLIC_URL.
DEN_DOCUMENTS_CALLBACK_BASE_URL=
# Where the editor runs: `fixed` (DEN_DOCUMENTS_COLLABORA_URL, the default when set) or
# `cloud-worker` (inside each member's OpenWork Cloud worker; needs OpenWork Web and a
# worker snapshot built with the editor). Unset with no Collabora URL leaves full editing off.
# DEN_DOCUMENTS_EDITOR=cloud-worker
# DEN_DOCUMENTS_WORKER_EDITOR_PORT=9980

# Sandbox organizations (/admin › Sandboxes). The workshop service their sample
# work apps connect to (OpenWork Cloud defaults to the public workshop), and the
# AI Gateway models every new sandbox gets for all members. Sandboxes are always
# created on the Enterprise plan until they end.
# Models, either:
# - one capped OpenRouter key per sandbox: set OPENROUTER_MANAGEMENT_API_KEY (above)
#   and leave DEN_SANDBOX_GATEWAY_API_KEY empty; DEN_SANDBOX_CREDIT_USD is the
#   default cap (50), changeable per sandbox. Closing a sandbox disables its key.
# - or one shared key every sandbox uses: DEN_SANDBOX_GATEWAY_API_KEY.
# DEN_SANDBOX_WORKPLACE_URL=https://open-workplace-workshop.onrender.com
# DEN_SANDBOX_GATEWAY_PROVIDER=openrouter
# DEN_SANDBOX_GATEWAY_MODELS=anthropic/claude-sonnet-5.5,openai/gpt-5.5,google/gemini-3.8-flash
# DEN_SANDBOX_CREDIT_USD=50
# DEN_SANDBOX_GATEWAY_API_KEY=
