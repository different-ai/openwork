{
  "name": "@openwork-ee/den-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:workspace-dependencies && OPENWORK_DEV_MODE=1 tsx watch src/main.ts",
    "dev:local": "pnpm run build:workspace-dependencies && OPENWORK_DEV_MODE=1 PORT=${DEN_API_PORT:-8790} tsx watch src/main.ts",
    "build": "node ./scripts/build.mjs",
    "build:workspace-dependencies": "pnpm --filter '@openwork-ee/den-api^...' --if-present run build",
    "build:den-db": "pnpm --filter @openwork-ee/den-db build",
    "build:mcp-apps": "pnpm --filter @openwork/mcp-apps build",
    "openapi:snapshot": "tsx scripts/generate-openapi-snapshot.ts",
    "smoke:config-object-payload-boundary": "tsx scripts/smoke-config-object-payload-boundary.ts",
    "test": "bun test --conditions development test/api-keys.test.ts test/bearer-session.test.ts test/cloud-provider-materialization-read-retry.test.ts test/remote-session-capability-wire.test.ts",
    "backfill:desktop-policies": "pnpm run build:den-db && tsx scripts/backfill-desktop-policies.ts",
    "migrate:skills-to-plugins": "pnpm run build:den-db && tsx scripts/migrate-skills-to-plugins.ts",
    "test:admin-scale": "bun test test/admin-scale-performance.test.ts",
    "typecheck:automations": "tsc -p tsconfig.automations-test.json --noEmit --pretty false",
    "seed:demo-org": "pnpm run build:den-db && OPENWORK_DEV_MODE=${OPENWORK_DEV_MODE:-1} DATABASE_URL=${DATABASE_URL:-mysql://root:password@127.0.0.1:3306/openwork_den} DEN_DB_ENCRYPTION_KEY=${DEN_DB_ENCRYPTION_KEY:-local-dev-db-encryption-key-please-change-1234567890} BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-local-dev-secret-not-for-production-use!!} BETTER_AUTH_URL=${BETTER_AUTH_URL:-http://localhost:${DEN_WEB_PORT:-3005}} tsx scripts/seed-demo-org.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.0-beta.10",
    "@better-auth/oauth-provider": "1.7.0-beta.10",
    "@better-auth/scim": "1.7.0-beta.10",
    "@better-auth/sso": "1.7.0-beta.10",
    "@hono/mcp": "^0.2.5",
    "@hono/node-server": "2.0.12",
    "@hono/otel": "1.1.2",
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.42.0",
    "@openwork-ee/cloud-runtime": "workspace:*",
    "@openwork-ee/cloud-runtime-daytona": "workspace:*",
    "@openwork-ee/den-db": "workspace:*",
    "@openwork-ee/telemetry": "workspace:*",
    "@openwork-ee/utils": "workspace:*",
    "@openwork/automations": "workspace:*",
    "@openwork/codemode": "workspace:*",
    "@openwork/connect-link": "workspace:*",
    "@openwork/email": "workspace:*",
    "@openwork/enterprise-mcp-client": "workspace:*",
    "@openwork/headless-threads": "workspace:*",
    "@openwork/install-config": "workspace:*",
    "@openwork/mcp-apps": "workspace:*",
    "@openwork/types": "workspace:*",
    "@sentry/hono": "10.64.0",
    "@sentry/node": "10.64.0",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "^0.2.9",
    "@standard-schema/spec": "^1.1.0",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "better-auth": "1.7.0-beta.10",
    "better-call": "1.3.7",
    "botid": "^1.5.11",
    "dotenv": "^16.4.5",
    "esbuild": "catalog:",
    "effect": "4.0.0-beta.83",
    "fast-xml-parser": "5.8.0",
    "grammy": "^1.44.0",
    "hono": "4.12.34",
    "hono-openapi": "^1.3.0",
    "htmlparser2": "8.0.2",
    "ioredis": "^6.0.0",
    "jsonc-parser": "^3.2.1",
    "nanoid": "3.3.18",
    "react": "catalog:",
    "react-dom": "catalog:",
    "openapi-types": "^12.1.3",
    "sharp": "0.35.3",
    "stripe": "^22.1.1",
    "undici": "7.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@sentry/cli": "3.6.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.11.30",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-types": "^1.3.6",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
