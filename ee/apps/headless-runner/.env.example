# Private service: generate a unique 32+ character token. Never expose it to browsers.
HEADLESS_API_TOKEN=
HEADLESS_MODEL_PROTOCOL=openai
HEADLESS_MODEL_BASE_URL=https://gateway.example.test/v1
HEADLESS_MODEL=your-model-alias
HEADLESS_MODEL_API_KEY=

# Optional end-user attribution. Also enable headlessModelAttribution in Den's
# registry rollout for the organization. Configure these on the RUNNER, not Den.
# Deploy the updated runner before enabling the rollout.
# Empty/unset means no identity header is sent. Authentication is unchanged.
HEADLESS_MODEL_USER_HEADER=
# member_id (default), user_id, owner (organizationId:memberId), email (PII opt-in)
HEADLESS_MODEL_USER_HEADER_FORMAT=member_id
