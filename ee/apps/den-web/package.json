{
  "name": "@openwork-ee/den-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "OPENWORK_DEV_MODE=1 NEXT_PUBLIC_POSTHOG_KEY= NEXT_PUBLIC_POSTHOG_API_KEY= next dev --hostname 0.0.0.0 --port 3005",
    "dev:local": "OPENWORK_DEV_MODE=1 NEXT_PUBLIC_POSTHOG_KEY= NEXT_PUBLIC_POSTHOG_API_KEY= next dev --hostname ${DEN_WEB_HOST:-0.0.0.0} --port ${DEN_WEB_PORT:-3005}",
    "prebuild": "pnpm --filter @openwork/types build && pnpm --dir ../../../packages/ui build && pnpm --dir ../../packages/utils build",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3005",
    "lint": "eslint app components --no-inline-config --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:gateway-usage-limits": "tsc --noEmit --pretty false -p tsconfig.usage-limits.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.42.0",
    "@openwork-ee/telemetry-contracts": "workspace:*",
    "@openwork-ee/utils": "workspace:*",
    "@openwork/features": "workspace:*",
    "@openwork/types": "workspace:*",
    "@openwork/ui": "workspace:*",
    "@paper-design/shaders-react": "0.0.72",
    "@sentry/nextjs": "10.64.0",
    "@tanstack/react-query": "^5.96.2",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "posthog-js": "1.430.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.12.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "5.4.5"
  }
}
