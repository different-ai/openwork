{
  "name": "@openwork-ee/gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "models:build": "node scripts/build-models.mjs",
    "dev": "pnpm run models:build && tsx watch src/server.ts",
    "dev:local": "OPENWORK_DEV_MODE=1 pnpm run models:build && OPENWORK_DEV_MODE=1 PORT=${GATEWAY_PORT-${INFERENCE_PORT:-8791}} tsx watch src/server.ts",
    "build": "pnpm run models:build && tsc -p tsconfig.json",
    "start": "node --import ./dist/instrumentation.js dist/server.js"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@openwork-ee/den-db": "workspace:*",
    "@openwork-ee/den-modules": "workspace:*",
    "@openwork-ee/telemetry": "workspace:*",
    "@openwork-ee/utils": "workspace:*",
    "@openwork/free-auto": "workspace:*",
    "@openwork/types": "workspace:*",
    "@sentry/hono": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "dotenv": "^16.4.5",
    "hono": "4.13.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/mistral": "3.0.51",
    "@types/node": "^20.11.30",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
