GATEWAY_PORT=8791
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=mysql://root:password@127.0.0.1:3306/openwork_den
DB_MODE=mysql
DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DEN_DB_ENCRYPTION_KEY=local-dev-db-encryption-key-please-change-1234567890
GATEWAY_PROXY_BASE_URL=http://localhost:8791
OPENROUTER_UPSTREAM_URL=https://openrouter.ai/api/v1
GATEWAY_ADMIN_TOKEN=local-dev-admin-token
GATEWAY_WEBHOOK_SECRET=local-dev-webhook-secret
GATEWAY_CREDITS_PER_DOLLAR=1000000
GATEWAY_UPSTREAM_TIMEOUT_MS=1800000
GATEWAY_EGRESS_ALLOWED_ORIGINS=
