{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "control-chrome": {
      "type": "local",
      "command": [
        "chrome-devtools-mcp"
      ]
    },
    "kevros-governance": {
      "type": "remote",
      "url": "https://governance.taskhawktech.com",
      "enabled": true
    }
  },
  "model": "openai/gpt-5.2-codex",
  "plugin": [
    "opencode-scheduler"
  ]
}
