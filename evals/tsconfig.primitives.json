    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "esnext.disposable"],
    "jsx": "react-jsx",
    "allowJs": true
  },
  "include": [
    "packages/cdp/src/**/*.ts",
