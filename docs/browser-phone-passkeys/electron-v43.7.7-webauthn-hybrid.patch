+
+void ElectronAuthenticatorRequestClientDelegate::ConfigureDiscoveries(
+    const url::Origin& origin,
+    const std::string& rp_id,
+    RequestSource request_source,
+    device::FidoRequestType request_type,
+    std::optional<device::ResidentKeyRequirement> resident_key_requirement,
+    device::UserVerificationRequirement user_verification_requirement,
+    std::optional<std::string_view> user_name,
+    bool is_enclave_authenticator_available,
+    device::FidoDiscoveryFactory* fido_discovery_factory) {
+  // Only modal WebAuthn requests get a QR code: conditional (autofill),
+  // passkey-upgrade and payment requests show no WebAuthn UI in Chrome either.
+  // //content has already validated the origin and RP ID at this point.
+  if (!fido_discovery_factory ||
+      request_source != RequestSource::kWebAuthentication ||
+      ui_presentation_ != UIPresentation::kModal ||
+      !HybridTransportAvailable()) {
+    return;
+  }
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(render_frame_host_id_);
+  if (!rfh) {
+    return;
+  }
+  base::WeakPtr<ElectronBrowserContext> browser_context =
+      static_cast<ElectronBrowserContext*>(rfh->GetBrowserContext())
+          ->GetWeakPtr();
+
+  // Chromium adds kHybrid to every request's transports but only creates the
+  // hybrid discovery once an embedder configures a QR generator key. The key
+  // is fresh per request and never leaves this process except inside the QR.
+  std::array<uint8_t, device::cablev2::kQRKeySize> qr_generator_key;
+  crypto::RandBytes(qr_generator_key);
+  const std::string qr_code =
+      device::cablev2::qr::Encode(qr_generator_key, request_type);
+  hybrid_request_id_ = NewHybridRequestId();
+
+  base::WeakPtr<ElectronAuthenticatorRequestClientDelegate> weak_this =
+      weak_factory_.GetWeakPtr();
+  const bool accepted = EmitHybridRequestEvent(request_type, qr_code);
+  if (!weak_this) {
+    return;
+  }
+  if (!accepted) {
+    hybrid_request_id_.clear();
+    return;
+  }
+
+  hybrid_browser_context_ = browser_context;
+  fido_discovery_factory->set_cable_data(request_type, qr_generator_key);
+  fido_discovery_factory->set_network_context_factory(
+      base::BindRepeating(&NetworkContextFor, browser_context));
+  fido_discovery_factory->set_cable_event_callback(base::BindRepeating(
+      &ElectronAuthenticatorRequestClientDelegate::OnCableEvent,
+      weak_factory_.GetWeakPtr()));
+}
+
+bool ElectronAuthenticatorRequestClientDelegate::EmitHybridRequestEvent(
+    device::FidoRequestType request_type,
+    const std::string& qr_code) {
+  gin::WeakCell<api::Session>* session = SessionForFrame(render_frame_host_id_);
+  if (!session || !session->Get()) {
+    return false;
+  }
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+
+  gin_helper::Dictionary details = gin_helper::Dictionary::CreateEmpty(isolate);
+  details.Set("requestId", hybrid_request_id_);
+  details.Set("relyingPartyId", relying_party_id_);
+  details.Set("requestType", RequestTypeName(request_type));
+  details.Set("qrCode", qr_code);
+  details.Set("frame", content::RenderFrameHost::FromID(render_frame_host_id_));
+  // cancel() ends the request; the page receives NotAllowedError.
+  details.SetMethod(
+      "cancel",
+      base::BindRepeating(
+          &ElectronAuthenticatorRequestClientDelegate::OnHybridCancelRequested,
+          weak_factory_.GetWeakPtr()));
+
+  gin_helper::internal::Event* event =
+      gin_helper::internal::Event::New(isolate);
+  v8::Local<v8::Object> event_object =
+      event->GetWrapper(isolate).ToLocalChecked();
+  EmitOnSession(session, "webauthn-hybrid-request", event_object,
+                details.GetHandle());
+  // Opt-in: a QR secret is only armed when the app takes over the request,
+  // like 'select-bluetooth-device'. No listener, or a listener that does not
+  // call preventDefault(), leaves WebAuthn exactly as before.
+  return event->GetDefaultPrevented();
+}
+
+void ElectronAuthenticatorRequestClientDelegate::EmitHybridStateEvent(
+    const char* state) {
+  if (!hybrid_browser_context_) {
+    return;
+  }
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  v8::Local<v8::Object> details =
+      gin::DataObjectBuilder(isolate)
+          .Set("requestId", hybrid_request_id_)
+          .Set("relyingPartyId", relying_party_id_)
+          .Set("state", state)
+          .Set("frame", content::RenderFrameHost::FromID(render_frame_host_id_))
+          .Build();
+  EmitOnSession(SessionForBrowserContext(hybrid_browser_context_.get()),
+                "webauthn-hybrid-request-updated",
+                gin_helper::internal::Event::New(isolate)
+                    ->GetWrapper(isolate)
+                    .ToLocalChecked(),
+                details);
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnCableEvent(
+    device::cablev2::Event event) {
+  switch (event) {
+    case device::cablev2::Event::kPhoneConnected:
+      EmitHybridStateEvent("phone-connected");
+      break;
+    case device::cablev2::Event::kBLEAdvertReceived:
+      EmitHybridStateEvent("advert-received");
+      break;
+    case device::cablev2::Event::kReady:
+      EmitHybridStateEvent("ready");
+      break;
+  }
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnHybridCancelRequested() {
+  // Called from JavaScript; cancelling destroys the request (and |this|), so
+  // do it from a fresh task.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ElectronAuthenticatorRequestClientDelegate::CancelRequest,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ElectronAuthenticatorRequestClientDelegate::
+    OnTransportAvailabilityEnumerated(
+        device::FidoRequestHandlerBase::TransportAvailabilityInfo data) {
+  if (!hybrid_browser_context_) {
+    return;
+  }
+  // Hybrid discovery listens for the phone's BLE advert, which on macOS needs
+  // the Bluetooth permission. Ask now so the system prompt appears.
+  OnBleStatus(data.ble_status);
+}
+
+void ElectronAuthenticatorRequestClientDelegate::BluetoothAdapterStatusChanged(
+    device::FidoRequestHandlerBase::BleStatus ble_status) {
+  if (hybrid_browser_context_) {
+    OnBleStatus(ble_status);
+  }
+}
+
+void ElectronAuthenticatorRequestClientDelegate::OnBleStatus(
+    device::FidoRequestHandlerBase::BleStatus status) {
+  switch (status) {
+    case device::FidoRequestHandlerBase::BleStatus::kOn:
+      break;
+    case device::FidoRequestHandlerBase::BleStatus::kOff:
+      // Chromium never powers the adapter on without the user; report it so
+      // the app can say so instead of leaving a QR code that cannot work.
+      EmitHybridStateEvent("bluetooth-off");
+      break;
+    case device::FidoRequestHandlerBase::BleStatus::kPermissionDenied:
+      FIDO_LOG(ERROR) << "Bluetooth permission denied; hybrid transport "
+                         "cannot discover the phone.";
+      EmitHybridStateEvent("bluetooth-permission-denied");
+      break;
+    case device::FidoRequestHandlerBase::BleStatus::kPendingPermissionRequest:
+      if (request_ble_permission_callback_) {
+        request_ble_permission_callback_.Run(base::BindOnce(
+            &ElectronAuthenticatorRequestClientDelegate::OnBleStatus,
+            weak_factory_.GetWeakPtr()));
+      }
+      break;
+  }
+}
