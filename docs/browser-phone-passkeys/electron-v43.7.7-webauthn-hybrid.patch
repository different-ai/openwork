+
+// Emits |name| with |details| on the session that owns |browser_context|.
+// Returns the event object so callers can read defaultPrevented.
+v8::Local<v8::Value> EmitOnSession(gin::WeakCell<api::Session>* session,
+                                   const char* name,
+                                   v8::Local<v8::Object> event_object,
+                                   v8::Local<v8::Object> details) {
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::Local<v8::Object> session_wrapper;
+  if (!session || !session->Get() ||
+      !session->Get()->GetWrapper(isolate).ToLocal(&session_wrapper)) {
+    return v8::Undefined(isolate);
+  }
+  return gin_helper::EmitEvent(isolate, session_wrapper, name, event_object,
+                               details);
+}
+
+// Completion is signalled by //content destroying the delegate, so this runs
+// from a task posted by the destructor rather than re-entering JavaScript
+// from inside teardown. The frame is often gone by then.
+void EmitHybridRequestCompleted(
+    base::WeakPtr<ElectronBrowserContext> browser_context,
+    content::GlobalRenderFrameHostId render_frame_host_id,
+    std::string request_id,
+    std::string relying_party_id) {
+  if (!browser_context) {
+    return;
+  }
+  v8::Isolate* isolate = JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  v8::Local<v8::Object> details =
+      gin::DataObjectBuilder(isolate)
+          .Set("requestId", request_id)
+          .Set("relyingPartyId", relying_party_id)
+          .Set("frame", content::RenderFrameHost::FromID(render_frame_host_id))
+          .Build();
+  EmitOnSession(SessionForBrowserContext(browser_context.get()),
+                "webauthn-hybrid-request-completed",
+                gin_helper::internal::Event::New(isolate)
+                    ->GetWrapper(isolate)
+                    .ToLocalChecked(),
+                details);
+}
