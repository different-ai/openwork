import type { TaskCenterItem } from "../types";

const startAutomation = (item: TaskCenterItem) => {
  const prompt = `使用 forge-orchestrator 处理 TFS 工作项 #${item.tfsId}`;
  options.setPrompt(prompt);
  // 只设置自动化状态，不自动开启会话
  // TODO: 添加手动启动功能（可选）
};

export { startAutomation };
```

