diff --git a/test/cancellation.test.mjs b/test/cancellation.test.mjs
new file mode 100644
index 000000000..cee36c289
--- /dev/null
+++ b/test/cancellation.test.mjs
@@ -0,0 +1,172 @@
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import vm from "node:vm";
+
+// Exercise the published provider, replacing transport only. No browser,
+// socket listener, HTTP service, or automation implementation is created.
+async function witness(options = {}) {
+  const packets = [];
+  const sockets = [];
+  const timers = new Set();
+  const writes = [];
+  let discoveries = 0;
+  class Socket extends EventEmitter {
+    static OPEN = 1;
+    readyState = 0;
+    constructor() {
+      super(); sockets.push(this);
+      queueMicrotask(() => {
+        options.connect?.();
+        if (this.readyState === 3 || options.holdConnect) return;
+        this.readyState = Socket.OPEN; this.emit("open");
+      });
+    }
+    send(payload) {
+      assert.equal(this.readyState, Socket.OPEN);
+      const packet = JSON.parse(payload);
+      packets.push(packet);
+      options.dispatch?.(packet, this);
+      let result = {};
+      if (packet.method === "Accessibility.getFullAXTree") result = { nodes: options.nodes ?? [
+        { nodeId: "root", role: { value: "RootWebArea" }, childIds: ["field"] },
+        { nodeId: "field", role: { value: "textbox" }, name: { value: "Field" }, backendDOMNodeId: 42 },
+      ] };
+      if (packet.method === "DOM.resolveNode") result = { object: { objectId: "field-object" } };
+      if (packet.method === "DOM.getBoxModel") result = { model: { content: [0, 0, 20, 0, 20, 20, 0, 20] } };
+      if (packet.method === "Page.captureScreenshot") result = { data: "UE5H" };
+      if (packet.method === "Runtime.evaluate") result = { result: { value: "Page" } };
+      queueMicrotask(() => {
+        if (this.readyState !== Socket.OPEN || options.holdResponse === packet.method) return;
+        this.emit("message", Buffer.from(JSON.stringify({ id: packet.id, result })));
+      });
+    }
+    terminate() { this.readyState = 3; this.emit("close"); }
+    close() { this.terminate(); }
+  }
+  const context = vm.createContext({
+    URL, Buffer, AbortController, AbortSignal, console,
+    setTimeout: (fn, ms) => { const timer = setTimeout(() => { timers.delete(timer); fn(); }, ms); timers.add(timer); return timer; },
+    clearTimeout: (timer) => { timers.delete(timer); clearTimeout(timer); },
+    fetch: async (_url, init) => {
+      discoveries++; options.discover?.(init);
+      init?.signal?.throwIfAborted();
+      return { ok: true, json: async () => [{ id: "page", type: "page", title: "Page", url: "https://example.test/", webSocketDebuggerUrl: "ws://127.0.0.1:9222/page" }] };
+    },
+  });
+  const url = new URL("../dist/plugin.js", import.meta.url);
+  const module = new vm.SourceTextModule(await readFile(url, "utf8"), { context, initializeImportMeta: (meta) => { meta.url = url.href; } });
+  await module.link(async (name) => {
+    const exports = name === "ws" ? { default: Socket } : name === "fs" ? { readFileSync: () => '{"name":"opencode-chrome-devtools","version":"1.0.4"}', writeFileSync: (...args) => writes.push(args) } : await import(`node:${name}`);
+    return new vm.SyntheticModule(Object.keys(exports), function () { for (const [key, value] of Object.entries(exports)) this.setExport(key, value); }, { context });
+  });
+  await module.evaluate();
+  const { tool } = await module.namespace.server();
+  const handle = { browser_url: "http://127.0.0.1:9222", target_id: "page" };
+  const call = (name, args = {}, abort = new AbortController().signal) => tool[name].execute({ ...handle, ...args }, { sessionID: "native-session", messageID: "native-message", callID: name, directory: "/workspace", abort });
+  return { call, packets, sockets, timers, writes, get discoveries() { return discoveries; } };
+}
+
+test("cancelled fill closes its socket and sends no remaining key events", async () => {
+  const controller = new AbortController();
+  const f = await witness({ dispatch: (packet) => {
+    if (packet.method === "Input.dispatchKeyEvent") controller.abort(new Error("cancelled fill"));
+  } });
+  assert.match(await f.call("browser_snapshot"), /\[2\] textbox/);
+  await assert.rejects(f.call("browser_fill", { uid: 2, value: "abcdef" }, controller.signal), /cancelled fill/);
+  await new Promise(setImmediate);
+  assert.deepEqual(f.packets.filter((packet) => packet.method === "Input.dispatchKeyEvent").map((packet) => packet.params), [{ type: "keyDown", text: "a" }]);
+  assert.ok(f.sockets.every((socket) => socket.readyState === 3));
+  assert.equal(f.timers.size, 0);
+});
+
+test("cancellation before each click dispatch prevents later mouse or fallback input", async () => {
+  for (const boundary of ["DOM.resolveNode", "DOM.getBoxModel", "Input.dispatchMouseEvent"]) {
+    const controller = new AbortController();
+    const f = await witness({ dispatch: (packet) => { if (packet.method === boundary) controller.abort(new Error("cancelled click")); } });
+    await f.call("browser_snapshot");
+    await assert.rejects(f.call("browser_click", { uid: 2 }, controller.signal), /cancelled click/);
+    const input = f.packets.filter((packet) => packet.method.startsWith("Input.") || packet.method === "Runtime.callFunctionOn");
+    assert.deepEqual(input.map((packet) => packet.params.type), boundary === "Input.dispatchMouseEvent" ? ["mousePressed"] : []);
+    assert.ok(f.sockets.every((socket) => socket.readyState === 3));
+    assert.equal(f.timers.size, 0);
+  }
+});
+
+test("pre-aborted tools do not discover targets or dispatch CDP", async () => {
+  const f = await witness();
+  const signal = AbortSignal.abort(new Error("cancelled before start"));
+  for (const name of ["browser_list", "browser_snapshot", "browser_click", "browser_fill", "browser_eval", "browser_navigate", "browser_screenshot"]) {
+    await assert.rejects(f.call(name, { uid: 2, value: "text", expression: "document.title", url: "https://example.test/" }, signal), /cancelled before start/);
+  }
+  assert.equal(f.discoveries, 0);
+  assert.equal(f.sockets.length, 0);
+  assert.equal(f.packets.length, 0);
+  assert.equal(f.writes.length, 0);
+});
+
+test("cancellation interrupts connection setup and outstanding capture without waiting for timeouts", async () => {
+  for (const holdConnect of [true, false]) {
+    const controller = new AbortController();
+    const f = await witness({ holdConnect, holdResponse: "Page.captureScreenshot" });
+    const operation = assert.rejects(f.call("browser_screenshot", {}, controller.signal), /cancelled capture/);
+    await new Promise(setImmediate);
+    controller.abort(new Error("cancelled capture"));
+    await operation;
+    assert.ok(f.sockets.every((socket) => socket.readyState === 3));
+    assert.equal(f.writes.length, 0);
+    assert.equal(f.timers.size, 0);
+  }
+});
+
+test("cancellation ends the navigation wait and prevents the follow-up evaluation", async () => {
+  const controller = new AbortController();
+  const f = await witness();
+  const operation = assert.rejects(f.call("browser_navigate", { url: "https://example.test/next" }, controller.signal), /cancelled navigation/);
+  await new Promise(setImmediate);
+  controller.abort(new Error("cancelled navigation"));
+  await operation;
+  assert.deepEqual(f.packets.map((packet) => packet.method), ["Page.enable", "Page.navigate"]);
+  assert.equal(f.timers.size, 0);
+});
+
+test("normal fill retains the provider's own key sequence and cleanup", async () => {
+  const f = await witness();
+  await f.call("browser_snapshot");
+  assert.match(await f.call("browser_fill", { uid: 2, value: "ab" }), /Filled/);
+  assert.deepEqual(f.packets.filter((packet) => packet.method === "Input.dispatchKeyEvent").map((packet) => packet.params), [
+    { type: "keyDown", text: "a" }, { type: "keyUp", text: "a" }, { type: "keyDown", text: "b" }, { type: "keyUp", text: "b" },
+  ]);
+  assert.ok(f.sockets.every((socket) => socket.readyState === 3));
+  assert.equal(f.timers.size, 0);
+});
+
+test("ignored roots and wrappers promote all child controls with their original backend identities", async () => {
+  for (const ignoredRoot of [false, true]) {
+    const f = await witness({ nodes: [
+      { nodeId: "root", ignored: ignoredRoot, name: { value: "Review root" }, role: { value: "RootWebArea" }, childIds: ["wrapper", "last"] },
+      { nodeId: "wrapper", ignored: true, role: { value: "none" }, childIds: ["nested", "increment", "hidden"] },
+      { nodeId: "nested", ignored: true, name: { value: "Ignored named wrapper" }, childIds: ["draft"] },
+      { nodeId: "draft", role: { value: "textbox" }, name: { value: "Draft text" }, backendDOMNodeId: 42 },
+      { nodeId: "increment", role: { value: "button" }, name: { value: "Increment" }, backendDOMNodeId: 77 },
+      { nodeId: "hidden", ignored: true, name: { value: "Hidden control" }, backendDOMNodeId: 99 },
+      { nodeId: "last", role: { value: "button" }, name: { value: "Finish" }, backendDOMNodeId: 88 },
+    ] });
+    const snapshot = await f.call("browser_snapshot");
+    assert.doesNotMatch(snapshot, /Ignored named wrapper|Hidden control/);
+    if (ignoredRoot) assert.doesNotMatch(snapshot, /Review root/);
+    else assert.match(snapshot, /\[1\] RootWebArea "Review root"/);
+    const draft = Number(snapshot.match(/\[(\d+)\] textbox "Draft text"/)?.[1]);
+    const increment = Number(snapshot.match(/\[(\d+)\] button "Increment"/)?.[1]);
+    const finish = Number(snapshot.match(/\[(\d+)\] button "Finish"/)?.[1]);
+    assert.ok(draft > 0 && increment > draft && finish > increment);
+    const uids = [...snapshot.matchAll(/\[(\d+)\]/g)].map((match) => match[1]);
+    assert.equal(new Set(uids).size, uids.length);
+    await f.call("browser_fill", { uid: draft, value: "Edited" });
+    await f.call("browser_click", { uid: increment });
+    await f.call("browser_click", { uid: finish });
+    assert.deepEqual(f.packets.filter((packet) => packet.method === "DOM.resolveNode").map((packet) => packet.params.backendNodeId), [42, 77, 88]);
+    assert.equal(f.timers.size, 0);
+  }
+});
