+const anthropicToolSchema = (schema: JsonSchema): JsonSchema => {
+  const combinators = ["anyOf", "oneOf", "allOf"] as const
+  const key = combinators.find((item) => Array.isArray(schema[item]))
+  if (!key) return schema.type === undefined ? { ...schema, type: "object" } : schema
+
+  const variants = (schema[key] as unknown[])
+    .filter((item): item is JsonSchema => typeof item === "object" && item !== null && !Array.isArray(item))
+    .map(anthropicToolSchema)
+  const properties: Record<string, unknown> =
+    typeof schema.properties === "object" && schema.properties !== null && !Array.isArray(schema.properties)
+      ? { ...schema.properties }
+      : {}
+  const requiredList = (value: unknown): string[] =>
+    Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : []
+  const requiredByVariant = variants.map((variant) => requiredList(variant.required))
+  for (const variant of variants) {
+    if (typeof variant.properties !== "object" || variant.properties === null || Array.isArray(variant.properties)) continue
+    for (const [name, property] of Object.entries(variant.properties)) {
+      if (!(name in properties)) properties[name] = property
+    }
+  }
+  const commonRequired = key === "allOf"
+    ? requiredByVariant.flat()
+    : (requiredByVariant[0] ?? []).filter((name) => requiredByVariant.every((items) => items.includes(name)))
+  const required = [...new Set([...requiredList(schema.required), ...commonRequired])]
+    .filter((name) => name in properties)
+  const result: Record<string, unknown> = { ...schema, type: "object", properties }
+  for (const item of combinators) delete result[item]
+  if (required.length) result.required = required
+  else delete result.required
+  if (key !== "allOf" && requiredByVariant.some((items) => items.length)) {
+    const hint = requiredByVariant.map((items) => `(${items.length ? items.join(", ") : "none"})`).join(" or ")
+    const description = typeof schema.description === "string" && schema.description ? `${schema.description}\n` : ""
+    result.description = `${description}Provide fields matching exactly one input variant; variant required fields: ${hint}.`
+  }
+  return result
+}
