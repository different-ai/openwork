diff --git a/packages/core/src/filesystem-scope.ts b/packages/core/src/filesystem-scope.ts
new file mode 100644
index 0000000000000000000000000000000000000000..78361a3390ae7cf84637353919cb2dfa3e1309a0
--- /dev/null
+++ b/packages/core/src/filesystem-scope.ts
@@ -0,0 +1,50 @@
+export * as FilesystemScope from "./filesystem-scope.js"
+
+import { Tool } from "@opencode/schema/tool"
+import { FSUtil } from "@opencode/util/fs-util"
+import { Context, Effect, Schema } from "effect"
+import path from "path"
+import { Project } from "./project.js"
+import { AbsolutePath } from "./schema.js"
+
+export const Current = Context.Reference<Tool.FilesystemScope | undefined>("@opencode/FilesystemScope", {
+  defaultValue: () => undefined,
+})
+
+const Directory = Schema.String.check(Schema.makeFilter((value) => path.isAbsolute(value) && !value.includes("\0")))
+const Input = Schema.Struct({
+  directory: Directory,
+  project: Schema.optionalKey(Schema.Struct({ id: Project.ID, directory: Directory })),
+})
+
+export const validate = Effect.fn("FilesystemScope.validate")(function* (
+  input: unknown,
+  fs: FSUtil.Interface,
+  projects: Project.Interface,
+) {
+  if (input === undefined) return undefined
+  const scope = yield* Schema.decodeUnknownEffect(Input)(input).pipe(
+    Effect.mapError((error) => new Tool.Error({ message: "Invalid invocation filesystem scope", error })),
+  )
+  const stat = yield* fs
+    .stat(scope.directory)
+    .pipe(Effect.mapError((error) => new Tool.Error({ message: "Invalid invocation owner directory", error })))
+  if (stat.type !== "Directory") return yield* new Tool.Error({ message: "Invocation owner must be a directory" })
+  const directory = AbsolutePath.make(
+    yield* fs
+      .resolve(scope.directory)
+      .pipe(Effect.mapError((error) => new Tool.Error({ message: "Invalid invocation owner directory", error }))),
+  )
+  if (scope.project) {
+    const inspected = yield* projects.resolve(directory, { persist: false })
+    if (inspected.id !== scope.project.id || inspected.directory !== scope.project.directory)
+      return yield* new Tool.Error({ message: "Invocation filesystem scope does not match the native owner project" })
+  }
+  const project = yield* projects.resolve(directory)
+  if (scope.project && (project.id !== scope.project.id || project.directory !== scope.project.directory))
+    return yield* new Tool.Error({ message: "Invocation owner project changed during scope resolution" })
+  return Object.freeze({ directory, project: Object.freeze({ id: project.id, directory: project.directory }) })
+})
+
+export const boundary = <A extends Tool.FilesystemScope>(location: A) =>
+  Effect.map(Current, (scope) => scope ?? location)
