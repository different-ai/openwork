{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@openwork/cdp": ["../../evals/packages/cdp/src/index.ts"] }
  },
  "include": ["./*.ts", "../../evals/packages/cdp/src/browser-globals.d.ts"]
}
