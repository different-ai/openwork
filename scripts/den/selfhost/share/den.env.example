# OpenWork Den self-host configuration
NODE_ENV=production
DB_MODE=mysql
DATABASE_URL=mysql://openwork:change-me@mysql.example.com:3306/openwork_den
DEN_DB_ENCRYPTION_KEY=replace-with-at-least-32-characters
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=https://openwork.example.com

# Private single-organization defaults (matching the Helm chart).
DEN_ORG_MODE=single_org
DEN_SINGLE_ORG_NAME=OpenWork
DEN_SINGLE_ORG_SLUG=default
DEN_SINGLE_ORG_OWNER_EMAILS=admin@example.com
DEN_SINGLE_ORG_ALLOW_PUBLIC_SIGNUP=false
DEN_REQUIRE_EMAIL_VERIFICATION=false
DEN_PASSWORD_BREACH_SCREENING_ENABLED=false
DEN_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# Public and internal origins.
DEN_API_PUBLIC_URL=https://api.openwork.example.com
DEN_API_BASE=http://127.0.0.1:8788
DEN_AUTH_ORIGIN=https://openwork.example.com
DEN_AUTH_FALLBACK_BASE=http://127.0.0.1:8788
DEN_BETTER_AUTH_TRUSTED_ORIGINS=https://openwork.example.com
CORS_ORIGINS=https://openwork.example.com,https://api.openwork.example.com
PROVISIONER_MODE=stub

DEN_API_PORT=8788
DEN_WEB_PORT=3005
DEN_BIND_HOST=0.0.0.0
DEN_WEB_HOST=0.0.0.0
