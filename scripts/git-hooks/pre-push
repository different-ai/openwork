#!/bin/sh
# Confidentiality tripwire (pre-push). Installed by `pnpm install` via
# scripts/git-hooks/install.mjs (sets core.hooksPath to this directory).
#
# Scans the branch name, unpushed commit messages, and added lines against the
# CONFIDENTIAL_TERMS list. The list is never stored in the repo: it comes from
# the environment or from Infisical when the CLI is available. Without either,
# only the structural checks (emails, Slack) run and a warning is printed.
#
# Bypass for an emergency only with: OPENWORK_SKIP_CONFIDENTIALITY=1 git push
set -eu

if [ "${OPENWORK_SKIP_CONFIDENTIALITY:-}" = "1" ]; then
  echo "confidentiality tripwire: skipped by OPENWORK_SKIP_CONFIDENTIALITY=1" >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
stdin="$(cat)"

if [ -z "${CONFIDENTIAL_TERMS:-}" ] && command -v infisical >/dev/null 2>&1; then
  CONFIDENTIAL_TERMS="$(cd "$repo_root" && infisical secrets get CONFIDENTIAL_TERMS --plain --silent 2>/dev/null || true)"
  export CONFIDENTIAL_TERMS
fi

if [ -z "${CONFIDENTIAL_TERMS:-}" ]; then
  echo "confidentiality tripwire: CONFIDENTIAL_TERMS unavailable (set it or log in to Infisical); running structural checks only" >&2
fi

printf '%s\n' "$stdin" | node "$repo_root/scripts/confidentiality-tripwire.mjs" pre-push
