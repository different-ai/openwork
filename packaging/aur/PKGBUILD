pkgname=micx
pkgver=0.18.14
pkgrel=1 # pkgrel should change when PKGBUILD does. Standard is to change back to 1 next time. Any interger is valid.
pkgdesc="An Open source alternative to Claude Cowork"
arch=('x86_64' 'aarch64')
url="https://github.com/different-ai/openwork"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'libdrm' 'libxkbcommon' 'mesa' 'dbus' 'hicolor-icon-theme')
options=(!strip)

# Architecture-specific sources and checksums
source_x86_64=("${pkgname}-${pkgver}-x64.tar.gz::${url}/releases/download/v${pkgver}/micx-linux-x64-${pkgver}.tar.gz")
sha256sums_x86_64=('56b09c794368d3a87cdf1dde995aec8f0694bc49abc4a90934a7367edbaf3aab')

source_aarch64=("${pkgname}-${pkgver}-arm64.tar.gz::${url}/releases/download/v${pkgver}/micx-linux-arm64-${pkgver}.tar.gz")
sha256sums_aarch64=('1192dbd5aedf44905dc6577082aa2e457146d4c987a66616573290dba5153b10')

package() {
  cd "${srcdir}"

  local bundle_dir
  case "${CARCH}" in
    x86_64)
      bundle_dir="micx-linux-x64-${pkgver}"
      ;;
    aarch64)
      bundle_dir="micx-linux-arm64-${pkgver}"
      ;;
    *)
      echo "Unsupported architecture: ${CARCH}" >&2
      return 1
      ;;
  esac

  install -d "${pkgdir}/opt/micx"
  cp -a "${bundle_dir}/." "${pkgdir}/opt/micx/"

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/micx/@micxdesktop "${pkgdir}/usr/bin/micx"

  install -Dm644 "${pkgdir}/opt/micx/resources/app-dist/micx-logo-square.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/micx.svg"

  install -d "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/micx.desktop" <<'EOF'
[Desktop Entry]
Name=Micx
Comment=Run agents, skills, and MCP workflows
Exec=micx %U
Terminal=false
Type=Application
Icon=micx
StartupWMClass=Micx
Categories=Development;Utility;
MimeType=x-scheme-handler/micx;
EOF

  chmod 4755 "${pkgdir}/opt/micx/chrome-sandbox"
}
