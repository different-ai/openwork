FROM node:22-bookworm-slim AS micx-builder

WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && npm install -g bun \
  && corepack enable \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN pnpm install --frozen-lockfile --trust-lockfile --filter micx-server... \
  && pnpm --filter micx-server build \
  && pnpm --filter micx-server build:bin

FROM node:22-bookworm-slim

ARG MICX_SERVER_VERSION
ARG OPENCODE_VERSION
ARG OPENCODE_DOWNLOAD_URL=

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar unzip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=micx-builder /src/apps/server/dist/bin/micx-server /usr/local/bin/micx-server
COPY --from=micx-builder /src/apps/server/dist/opencode-plugins /opt/micx/opencode-plugins
COPY --from=micx-builder /src/constants.json /usr/local/constants.json
COPY packaging/docker/microsandbox-entrypoint.sh /usr/local/bin/microsandbox-entrypoint.sh

RUN set -eux; \
  test -n "$MICX_SERVER_VERSION"; \
  test -n "$OPENCODE_VERSION"; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) asset="opencode-linux-x64-baseline.tar.gz" ;; \
    arm64) asset="opencode-linux-arm64.tar.gz" ;; \
    *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
  esac; \
  url="$OPENCODE_DOWNLOAD_URL"; \
  if [ -z "$url" ]; then \
    url="https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/${asset}"; \
  fi; \
  tmpdir="$(mktemp -d)"; \
  curl -fsSL "$url" -o "$tmpdir/$asset"; \
  tar -xzf "$tmpdir/$asset" -C "$tmpdir"; \
  binary="$(find "$tmpdir" -type f -name opencode | head -n 1)"; \
  test -n "$binary"; \
  install -m 0755 "$binary" /usr/local/bin/opencode; \
  chmod +x /usr/local/bin/microsandbox-entrypoint.sh; \
  rm -rf "$tmpdir"

RUN test -f /opt/micx/opencode-plugins/micx-extensions-preview.js \
  && test -f /opt/micx/opencode-plugins/micx-capabilities-knowledge.js \
  && test -f /opt/micx/opencode-plugins/micx-office-attachments.js \
  && test -f /opt/micx/opencode-plugins/micx-anthropic-adaptive-thinking.js \
  && test -f /opt/micx/opencode-plugins/micx-anthropic-tool-schema.js \
  && test "$(micx-server --version)" = "$MICX_SERVER_VERSION" \
  && opencode --version

ENV MICX_EXTENSIONS_PLUGIN_DIR=/opt/micx/opencode-plugins
ENV MICX_DATA_DIR=/data/micx-server
ENV MICX_SIDECAR_DIR=/data/sidecars
ENV MICX_WORKSPACE=/workspace

EXPOSE 8787

VOLUME ["/workspace", "/data"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD /bin/sh -c 'curl -fsS "http://127.0.0.1:${MICX_PORT:-8787}/health" >/dev/null || exit 1'

ENTRYPOINT ["/usr/local/bin/microsandbox-entrypoint.sh"]
