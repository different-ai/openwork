{
  "name": "@different-ai/openwork-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "cross-env OPENWORK_DEV_MODE=1 corepack pnpm --filter @openwork/desktop dev",
    "dev:ui": "cross-env OPENWORK_DEV_MODE=1 corepack pnpm --filter @openwork/app dev",
    "dev:story": "cross-env OPENWORK_DEV_MODE=1 corepack pnpm --filter @openwork/story-book dev",
    "dev:web": "cross-env OPENWORK_DEV_MODE=1 corepack pnpm --filter @openwork-ee/den-web dev",
    "dev:web-local": "OPENWORK_DEV_MODE=1 bash scripts/dev-web-local.sh",
    "dev:den-docker": "bash packaging/docker/den-dev-up.sh",
    "dev:headless-web": "cross-env OPENWORK_DEV_MODE=1 bun scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "corepack pnpm --filter @openwork/app build",
    "build:web": "corepack pnpm --filter @openwork-ee/den-web build",
    "preview": "corepack pnpm --filter @openwork/app preview",
    "typecheck": "corepack pnpm --filter @openwork/app typecheck",
    "test:health": "corepack pnpm --filter @openwork/app test:health",
    "test:sessions": "corepack pnpm --filter @openwork/app test:sessions",
    "test:refactor": "corepack pnpm --filter @openwork/app test:refactor",
    "test:events": "corepack pnpm --filter @openwork/app test:events",
    "test:todos": "corepack pnpm --filter @openwork/app test:todos",
    "test:permissions": "corepack pnpm --filter @openwork/app test:permissions",
    "test:session-switch": "corepack pnpm --filter @openwork/app test:session-switch",
    "test:fs-engine": "corepack pnpm --filter @openwork/app test:fs-engine",
    "test:e2e": "corepack pnpm --filter @openwork/app test:e2e",
    "test:orchestrator": "corepack pnpm --filter openwork-orchestrator test:router",
    "bump:patch": "corepack pnpm --filter @openwork/app bump:patch",
    "bump:minor": "corepack pnpm --filter @openwork/app bump:minor",
    "bump:major": "corepack pnpm --filter @openwork/app bump:major",
    "bump:set": "corepack pnpm --filter @openwork/app bump:set",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "release:ship": "node scripts/release/ship.mjs",
    "release:ship:watch": "node scripts/release/ship.mjs --watch",
    "tauri": "corepack pnpm --filter @openwork/desktop exec tauri"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "better-sqlite3",
      "esbuild",
      "protobufjs"
    ],
    "patchedDependencies": {
      "@solidjs/router@0.15.4": "patches/@solidjs__router@0.15.4.patch"
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "packageManager": "pnpm@10.27.0"
}
