{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "types": ["bun"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"]
}
