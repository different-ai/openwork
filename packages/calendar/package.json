{
  "name": "@openwork/calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Calendar logic shared by the desktop app and Workbot: time and DST helpers, Google and Outlook adapters over Den's calendar routes, Automation blocks, layout and formatting, and TanStack Query hooks.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
