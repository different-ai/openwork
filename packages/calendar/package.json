    "@openwork/types": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.3",
    "bun-types": "^1.3.6",
    "typescript": "^5.9.3"
  }
