      "types": "./tools.d.ts",
      "default": "./tools.mjs"
    },
    "./preload": "./browser-content-preload.cjs"
  },
  "files": [
    "index.d.ts",
    "index.mjs",
    "electron.mjs",
    "tools.d.ts",
