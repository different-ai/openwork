{
  "name": "@openwork/app-tools",
  "version": "0.1.0",
  "description": "Validation, deterministic packaging, and verification tools for OpenWork Apps.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "openwork-app": "./bin/openwork-app.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/different-ai/openwork.git",
    "directory": "packages/app-tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openwork/app-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
