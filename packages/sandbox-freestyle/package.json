{
  "name": "@openwork/sandbox-freestyle",
  "private": true,
  "type": "module",
  "description": "Freestyle compute, processes, files, pause and snapshots for OpenWork sandboxes.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "tsx --test src/unit.test.ts",
    "test:live": "tsx --test --test-concurrency=1 src/live.test.ts"
  },
  "dependencies": {
    "@openwork/sandbox": "workspace:*",
    "freestyle": "0.2.13"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.5.0",
    "typescript": "^5.5.4",
    "tsx": "^4.23.1"
  },
  "license": "MIT"
}
