{
  "name": "@openwork/features",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenWork preview flags: declare unfinished work once, resolve it per deployment and organization.",
  "exports": {
    ".": {
      "types": {
        "openwork-build": "./dist/types/src/index.d.ts",
        "default": "./src/index.ts"
      },
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry": {
      "types": {
        "openwork-build": "./dist/types/src/registry.d.ts",
        "default": "./src/registry.ts"
      },
      "development": "./src/registry.ts",
      "default": "./src/registry.ts"
    },
    "./resolve": {
      "types": {
        "openwork-build": "./dist/types/src/resolve.d.ts",
        "default": "./src/resolve.ts"
      },
      "development": "./src/resolve.ts",
      "default": "./src/resolve.ts"
    },
    "./define": {
      "types": {
        "openwork-build": "./dist/types/src/define.d.ts",
        "default": "./src/define.ts"
      },
      "development": "./src/define.ts",
      "default": "./src/define.ts"
    },
    "./previews": {
      "types": {
        "openwork-build": "./dist/types/src/previews.d.ts",
        "default": "./src/previews.ts"
      },
      "development": "./src/previews.ts",
      "default": "./src/previews.ts"
    },
    "./retired": {
      "types": {
        "openwork-build": "./dist/types/src/retired.d.ts",
        "default": "./src/retired.ts"
      },
      "development": "./src/retired.ts",
      "default": "./src/retired.ts"
    },
    "./preview-rules": {
      "types": {
        "openwork-build": "./dist/types/src/preview-rules.d.ts",
        "default": "./src/preview-rules.ts"
      },
      "development": "./src/preview-rules.ts",
      "default": "./src/preview-rules.ts"
    },
    "./capability-check": {
      "types": {
        "openwork-build": "./dist/types/src/capability-check.d.ts",
        "default": "./src/capability-check.ts"
      },
      "development": "./src/capability-check.ts",
      "default": "./src/capability-check.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3"
  }
}
