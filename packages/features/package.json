{
  "name": "@openwork/features",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenWork feature registry: declare a feature once, resolve it per deployment and organization.",
  "exports": {
    ".": {
      "types": {
        "openwork-build": "./dist/types/src/index.d.ts",
        "default": "./src/index.ts"
      },
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry": {
      "types": {
        "openwork-build": "./dist/types/src/registry.d.ts",
        "default": "./src/registry.ts"
      },
      "development": "./src/registry.ts",
      "default": "./src/registry.ts"
    },
    "./resolve": {
      "types": {
        "openwork-build": "./dist/types/src/resolve.d.ts",
        "default": "./src/resolve.ts"
      },
      "development": "./src/resolve.ts",
      "default": "./src/resolve.ts"
    },
    "./define": {
      "types": {
        "openwork-build": "./dist/types/src/define.d.ts",
        "default": "./src/define.ts"
      },
      "development": "./src/define.ts",
      "default": "./src/define.ts"
    },
    "./all-flags": {
      "types": {
        "openwork-build": "./dist/types/src/all-flags.d.ts",
        "default": "./src/all-flags.ts"
      },
      "development": "./src/all-flags.ts",
      "default": "./src/all-flags.ts"
    },
    "./flags/*": {
      "types": {
        "openwork-build": "./dist/types/src/flags/*.d.ts",
        "default": "./src/flags/*.ts"
      },
      "development": "./src/flags/*.ts",
      "default": "./src/flags/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.6.3"
  }
}
