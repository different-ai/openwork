{
  "name": "@openwork/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Generated TypeScript SDK for the OpenWork Den cloud API",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "openwork-build": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "development": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": {
        "openwork-build": "./dist/client.d.ts",
        "default": "./src/client.ts"
      },
      "development": "./src/client.ts",
      "bun": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./browser": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "node script/generate.mjs",
    "generate:check": "node script/generate.mjs --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "prettier": "3.8.3",
    "typescript": "^5.9.0"
  }
}
