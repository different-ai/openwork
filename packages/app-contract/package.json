{
  "name": "@openwork/app-contract",
  "version": "0.1.0",
  "description": "Public contract for OpenWork Apps: manifest standard, permission vocabulary, contributions, capability schemas, lifecycle model, and the canonical validator.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "schema": "bun run scripts/emit-schema.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/different-ai/openwork.git",
    "directory": "packages/app-contract"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
