          "type": "array"
        }
      },
      "required": [
        "summary",
        "data_handled",
        "retention"
      ],
      "type": "object"
    },
    "publisher": {
      "additionalProperties": false,
      "properties": {
        "contact": {
          "format": "email",
          "maxLength": 160,
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string"
        },
        "name": {
          "maxLength": 96,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "maxLength": 255,
          "pattern": "^https:\\/\\/[^\\s]+$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "repository": {
      "maxLength": 255,
      "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$",
      "type": "string"
    },
    "update": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "github-release",
          "type": "string"
        },
        "rollback_supported": {
          "type": "boolean"
        }
      },
      "required": [
        "channel",
        "rollback_supported"
      ],
      "type": "object"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "manifest_version",
    "id",
    "name",
    "description",
    "version",
    "publisher",
    "repository",
    "license",
    "icons",
    "engines",
