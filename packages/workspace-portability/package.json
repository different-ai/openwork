{
  "name": "@openwork/workspace-portability",
  "version": "0.1.0-experimental.0",
  "private": true,
  "description": "Portable workspace bundle contracts, path policy, and sensitive export handling",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "openwork": {
    "packageContract": {
      "schemaVersion": 1,
      "capability": "workspace-portability",
      "layer": "domain",
      "realms": [
        "neutral"
      ],
      "stability": "experimental"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.15.7",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
