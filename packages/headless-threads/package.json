{
  "name": "@openwork/headless-threads",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "bun": "./src/v2.ts",
      "development": "./src/v2.ts",
      "default": "./dist/v2.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/v2.ts --format esm --dts --clean --external zod --target es2022",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test src",
    "test:v2": "node --test src/v2-client.test.ts src/v2-execution.test.ts",
    "test:v2:smoke": "node --test src/v2-smoke.test.ts",
    "test:v2:renderer": "node --test src/v2-renderer.test.mjs"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "bun-types": "^1.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
