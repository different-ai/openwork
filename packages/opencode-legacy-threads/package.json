{
  "name": "@openwork/opencode-legacy-threads",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Read v1 chats and selectively continue them in OpenCode v2.",
  "exports": {
    "./server": {
      "types": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    },
    ".": {
      "types": "./src/plugin.ts",
      "bun": "./src/plugin.ts",
      "development": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    },
    "./service": {
      "types": "./src/service.d.mts",
      "default": "./src/service.mjs"
    },
    "./tui": {
      "types": "./src/tui.tsx",
      "bun": "./src/tui.tsx",
      "development": "./src/tui.tsx",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "bun": "./src/rpc.ts",
      "development": "./src/rpc.ts",
      "default": "./dist/rpc.js"
    }
  },
  "files": [
    "src",
    "dist",
    "server.js",
    "tui.js",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "bun script/build.ts",
    "test": "bun script/build.ts && bun --conditions=browser test test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/schema": "0.0.0-beta-19086",
    "@opencode-ai/plugin": "0.0.0-beta-19086",
    "effect": "4.0.0-rc.112",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
