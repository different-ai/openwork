{
  "name": "@openwork/contribution-registry",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-safe registration kernel for explicit OpenWork composition roots",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.15.7",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
