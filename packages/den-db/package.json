{
  "name": "@openwork/den-db",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:utils && tsc -p tsconfig.json",
    "build:utils": "npm --prefix ../utils run build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "dependencies": {
    "@planetscale/database": "^1.19.0",
    "drizzle-orm": "^0.45.1",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.5.4"
  }
}
