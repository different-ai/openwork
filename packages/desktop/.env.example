# OpenWork Local Development Environment Configuration
# Copy this file to packages/desktop/.env and customize as needed

# Use system-installed opencode instead of downloading sidecar
# Set to true if you have opencode installed globally (e.g., via npm, brew, etc.)
USE_SYSTEM_OPENCODE=true

# Optional: Explicitly specify opencode binary path
# If not set, will search in PATH
# OPENCODE_BIN_PATH=C:\Users\YourName\AppData\Roaming\npm\opencode.exe

# OpenWork Server and Openwrk will use local dev mode (bun run)
# No additional configuration needed for these
