{
  "name": "@openwork/automations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "openwork-build": "./dist/types/src/index.d.ts",
        "default": "./src/index.ts"
      },
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": {
        "openwork-build": "./dist/types/src/testing.d.ts",
        "default": "./src/testing.ts"
      },
      "bun": "./src/testing.ts",
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node --test test/production-exports.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=development --test src/*.test.ts"
  },
  "dependencies": {
    "@openwork/types": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "bun-types": "^1.3.6",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
