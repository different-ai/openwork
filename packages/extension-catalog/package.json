{
  "name": "@openwork/extension-catalog",
  "version": "0.1.0-experimental.0",
  "private": true,
  "description": "Validated built-in OpenWork extension catalog and compatibility projections",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./den-marketplace": {
      "types": "./src/den-marketplace.ts",
      "development": "./src/den-marketplace.ts",
      "default": "./dist/den-marketplace.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openwork/extension-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.15.7",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
