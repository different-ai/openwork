{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenWork Server V2",
    "description": "OpenAPI contract for the standalone OpenWork Server V2 runtime and durable registry state.\n\nPhase 3 adds runtime asset resolution, OpenCode and router supervision, persisted runtime health, and server-owned /system/runtime/* status routes.",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Server-level operational routes and contract metadata."
    },
    {
      "name": "Workspaces",
      "description": "Workspace-first resources will live under /workspaces/:workspaceId."
    },
    {
      "name": "Runtime",
      "description": "Server-owned runtime supervision, versions, and child process health."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getIndex",
        "tags": [
          "System"
        ],
        "summary": "Get server root information",
        "description": "Returns the root metadata for the standalone Server V2 process and its route conventions.",
        "responses": {
          "200": {
            "description": "Server root information returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2RootInfoResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to complete the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/system/health": {
      "get": {
        "operationId": "getSystemHealth",
        "tags": [
          "System"
        ],
        "summary": "Check Server V2 health",
        "description": "Returns a lightweight health response for the standalone Server V2 process.",
        "responses": {
          "200": {
            "description": "Server health returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to complete the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/system/meta": {
      "get": {
        "operationId": "getSystemMeta",
        "tags": [
          "System"
        ],
        "summary": "Get foundation metadata",
        "description": "Returns middleware ordering, route namespace conventions, sqlite bootstrap status, and startup import diagnostics.",
        "responses": {
          "200": {
            "description": "Server metadata returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2MetadataResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to complete the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/system/opencode/health": {
      "get": {
        "operationId": "getSystemOpencodeHealth",
        "tags": [
          "Runtime"
        ],
        "summary": "Get OpenCode health",
        "description": "Returns the server-owned OpenCode runtime health, version, URL, and recent diagnostics.",
        "responses": {
          "200": {
            "description": "OpenCode runtime health returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2OpencodeHealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to complete the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/system/router/health": {
      "get": {
        "operationId": "getSystemRouterHealth",
        "tags": [
          "Runtime"
        ],
        "summary": "Get router health",
        "description": "Returns the server-owned opencode-router health, enablement decision, and recent diagnostics.",
        "responses": {
          "200": {
            "description": "Router runtime health returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2RouterHealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to complete the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/system/runtime/summary": {
      "get": {
        "operationId": "getSystemRuntimeSummary",
        "tags": [
          "Runtime"
        ],
        "summary": "Get runtime summary",
        "description": "Returns the current runtime supervision summary, manifest, restart policy, and child process state.",
        "responses": {
          "200": {
            "description": "Runtime summary returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2RuntimeSummaryResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to complete the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/system/runtime/versions": {
      "get": {
        "operationId": "getSystemRuntimeVersions",
        "tags": [
          "Runtime"
        ],
        "summary": "Get runtime versions",
        "description": "Returns the active and pinned runtime versions that Server V2 resolved for OpenCode and opencode-router.",
        "responses": {
          "200": {
            "description": "Runtime versions returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2RuntimeVersionsResponse"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to complete the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenWorkServerV2InternalError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OpenWorkServerV2RouteNamespaces": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string",
            "const": "/"
