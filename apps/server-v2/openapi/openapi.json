          "openapi": {
            "type": "string",
            "const": "/openapi.json"
          },
          "system": {
            "type": "string",
            "const": "/system"
          },
          "workspaces": {
            "type": "string",
            "const": "/workspaces"
          },
          "workspaceResource": {
            "type": "string",
            "pattern": "^\\/workspaces\\/.*"
          }
        },
        "required": [
          "root",
          "openapi",
          "system",
          "workspaces",
          "workspaceResource"
        ]
      },
