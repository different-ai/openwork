{
  "name": "@openwork/coworker-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open Coworker website: a static site built from the desktop app's own brand, avatar, and product truths.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test src/*.test.ts",
    "og:render": "electron scripts/render-og.cjs"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
