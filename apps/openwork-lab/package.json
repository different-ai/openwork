{
  "name": "@openwork/openwork-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "OPENWORK_DEV_MODE=1 next dev --hostname 0.0.0.0 --port 3016",
    "build": "pnpm run build:web",
    "build:web": "next build",
    "start": "pnpm run start:web",
    "start:web": "next start --hostname 0.0.0.0 --port 3016",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "node scripts/electron-start.mjs"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.1.31",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.19",
    "electron": "^37.2.0",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.7",
    "typescript": "5.4.5"
  }
}
